# Copy this file to .env and adjust as needed.  .env is gitignored (never commit it).
#   cp .env.example .env

# Which LLM provider the agent uses: ollama | anthropic | openai
# Default is ollama: a free, local model. No API key, nothing leaves your machine.
LLM_PROVIDER=ollama

# Ollama (default, free + local). Pull the model first:  ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
# OLLAMA_HOST=http://localhost:11434   # only set if Ollama runs on a non-default host/port

# Anthropic (optional fallback; only used if LLM_PROVIDER=anthropic). Paid API.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenAI (optional fallback; only used if LLM_PROVIDER=openai). Paid API.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Local kind cluster name (keep in sync with scripts/dev.sh and manifests/kind-cluster.yaml)
CLUSTER_NAME=incident-responder

# Least privilege: impersonate per-component ServiceAccounts so the cluster
# enforces read-only vs write-scoped access (manifests/rbac.yaml must be applied).
# Set to false to run as your kubeconfig user instead.
USE_RBAC=true
K8S_NAMESPACE=default
